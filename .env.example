# ===== RAG Local Assistant — Environment Configuration =====
# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามเครื่องของคุณ

# ---------- OCR (สำหรับ PDF ที่เป็นภาพสแกน — ใช้ Tesseract OCR) ----------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\path\to\poppler\bin  # (Optional: fallback สำหรับแปลง PDF เป็นภาพ)

# ---------- Embedding Model ----------
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- Storage ----------
# SESSION_FILE=sessions.json
# CHROMA_DIR=chroma_db

# ---------- RAG Parameters ----------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100

# ---------- LLM ----------
# LLM_TEMPERATURE=0
# LLM_NUM_CTX=4096
